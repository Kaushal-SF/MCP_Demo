# Copy to .env (never commit .env) or set these in your MCP client's "env" block.

# Optional. If unset, DevFlow uses your GitHub CLI login (gh auth token).
# For least privilege, use a fine-grained PAT with read access to: Pull requests, Contents,
# Checks/Commit statuses, Metadata.
# GITHUB_TOKEN=

# Optional. Set for GitHub Enterprise Server, e.g. https://github.example.com/api/v3
# GITHUB_API_URL=

# Optional. trace | debug | info | warn | error | fatal | silent   (logs go to stderr)
# DEVFLOW_LOG_LEVEL=info

# Optional. Extra comma-separated glob patterns treated as sensitive by analyze_pr_risk.
# DEVFLOW_SENSITIVE_PATHS=src/payments/**,infra/**

# Optional. Folder of your team's own review checklists (*.md). Defaults to the bundled ones.
# DEVFLOW_CHECKLISTS_DIR=/path/to/team/checklists
